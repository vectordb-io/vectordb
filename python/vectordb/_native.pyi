class VectorDBError(Exception): ...
class InvalidArgumentError(VectorDBError): ...
class NotFoundError(VectorDBError): ...
class ConflictError(VectorDBError): ...
class UnsupportedError(VectorDBError): ...
class StorageError(VectorDBError): ...
class ClosedError(VectorDBError): ...

__version__: str

class NativeEngine:
    def __init__(self, path: str | None = None) -> None: ...
    def execute_json(self, operation: str, request: str) -> str: ...
    def close(self) -> None: ...
    @property
    def closed(self) -> bool: ...
    def flush(self) -> None: ...
    def backup(self, path: str) -> None: ...
